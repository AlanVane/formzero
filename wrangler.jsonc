{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "formzero",
	"compatibility_date": "2025-04-04",
	"compatibility_flags": [
        "nodejs_compat"
    ],
	"main": "./workers/app.ts",
	// Cloudflare Email Service send binding. A Worker cannot dial the Email
	// Service SMTP endpoint (Cloudflare-owned addresses are refused by the
	// socket proxy), so this binding is the only path that reaches it.
	"send_email": [
		{
			"name": "EMAIL",
			"remote": true
		}
	],
	"vars": {
		// Default sending method until the settings page stores one: "smtp"
		// keeps local runs on the nodemailer path, where a fake SMTP server
		// replaces real delivery.
		"MAIL_TRANSPORT": "cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "formzero",
			"database_id": "4fcc8bf0-2125-46b2-83e6-4d5dcf24ffcc",
		}
	],
	// Per-location, per-key cap on submissions. Complements the zone-level WAF
	// rate limiting rule: the edge rule cannot distinguish forms, this one keys
	// on IP + formId and returns the API's own JSON error shape.
	"ratelimits": [
		{
			"name": "SUBMISSION_LIMITER",
			"namespace_id": "90210",
			"simple": {
				"limit": 3,
				"period": 10
			}
		}
	]
}